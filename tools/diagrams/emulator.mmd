flowchart TB
    classDef app fill:#DBE4FF,stroke:#4C6EF5,color:#1A1A1A
    classDef shaper fill:#FFE3E3,stroke:#E03131,color:#1A1A1A
    classDef net fill:#F1F3F5,stroke:#868E96,color:#1A1A1A

    subgraph PROC["One load-generator process"]
        APP["quic-go session<br/>or Pion ICE mux"]:::app
        subgraph EMU["internal/netem: impairing net.PacketConn"]
            UP["UPLINK shaper<br/>propagation delay"]:::shaper
            DOWN["DOWNLINK shaper<br/>1. iid loss drop<br/>2. token-bucket serialization<br/>at rate cap, 200ms queue cap<br/>3. delay + uniform jitter<br/>via scheduler heap"]:::shaper
        end
        SOCK["real UDP socket"]:::net
    end
    RELAY["relay / SFU / origin"]:::net

    APP -->|WriteTo| UP --> SOCK --> RELAY
    RELAY --> SOCK2["ingress"]:::net --> DOWN -->|ReadFrom| APP

    CTRL["expctl<br/>POST /netem/apply"]:::net -.->|updates profile atomically| EMU
