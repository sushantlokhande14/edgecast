{
  "uid": "edgecast-netem",
  "title": "EdgeCast / Experiments and Network Conditions",
  "tags": ["edgecast"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Emulated RTT per container (base + scenario)",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "fillOpacity": 8 } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "edgecast_netem_rtt_ms", "legendFormat": "{{instance}}" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Emulated downlink loss",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent", "custom": { "fillOpacity": 8 } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "edgecast_netem_loss_pct", "legendFormat": "{{instance}}" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "Emulated downlink rate cap (0 = unlimited)",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "Kbits", "custom": { "fillOpacity": 8 } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "edgecast_netem_rate_kbit", "legendFormat": "{{instance}}" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Emulated jitter",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "fillOpacity": 8 } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "edgecast_netem_jitter_ms", "legendFormat": "{{instance}}" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Link emulator packet drops /s (by cause)",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 12 } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum by (instance, cause) (rate(edgecast_netem_dropped_packets_total[$__rate_interval]))", "legendFormat": "{{instance}} {{cause}}" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "Simulated TCP retransmission pauses /s (HLS path)",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 12 } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "rate(edgecast_netem_tcp_loss_pauses_total[$__rate_interval])", "legendFormat": "{{instance}}" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "MoQ throughput by region",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "bps", "custom": { "fillOpacity": 12 } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum by (region) (rate(edgecast_sub_bytes_total{protocol=\"moq\"}[$__rate_interval])) * 8", "legendFormat": "{{region}}" }]
    },
    {
      "id": 8, "type": "timeseries", "title": "MoQ startup p95 by region (joins in last 30m)",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 12 } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, region) (increase(edgecast_sub_startup_seconds_bucket{protocol=\"moq\"}[30m])))", "legendFormat": "{{region}}" }]
    }
  ]
}
