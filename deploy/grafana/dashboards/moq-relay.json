{
  "uid": "edgecast-relay",
  "title": "EdgeCast / MoQ Relay Deep Dive",
  "tags": ["edgecast"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Publisher bitrate (ABR ladder position)",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "Kbits", "custom": { "fillOpacity": 20 } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "edgecast_pub_bitrate_kbps", "legendFormat": "publisher tier" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Publisher group write time p90 (backpressure signal)",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 12 } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.90, sum by (le) (rate(edgecast_pub_group_write_seconds_bucket[$__rate_interval])))", "legendFormat": "p90 write time / 1s group" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "Relay ingest (from publisher / upstream)",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "bps", "custom": { "fillOpacity": 12 } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "rate(edgecast_relay_bytes_in_total{instance=~\"relay.*\"}[$__rate_interval]) * 8", "legendFormat": "{{instance}}" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Relay fanout to subscribers",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "bps", "custom": { "fillOpacity": 12 } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "rate(edgecast_relay_fanout_bytes_total{instance=~\"relay.*\"}[$__rate_interval]) * 8", "legendFormat": "{{instance}}" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Relay sessions by role",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "fillOpacity": 12 } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum by (role) (edgecast_relay_sessions)", "legendFormat": "{{role}}" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "Groups dropped under backpressure /s",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 12 } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "rate(edgecast_relay_groups_dropped_total{instance=~\"relay.*\"}[$__rate_interval])", "legendFormat": "{{instance}}" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "Late joins served from group cache /s",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 12 } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "rate(edgecast_relay_late_joins_total{instance=~\"relay.*\"}[$__rate_interval])", "legendFormat": "{{instance}}" }]
    },
    {
      "id": 8, "type": "timeseries", "title": "Pull-through upstream subscriptions",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "fillOpacity": 12 } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "edgecast_relay_upstream_subscriptions{instance=~\"relay.*\"}", "legendFormat": "{{instance}}" }]
    },
    {
      "id": 9, "type": "timeseries", "title": "ABR tier changes per minute",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "fillOpacity": 12 } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "60 * rate(edgecast_pub_tier_changes_total[$__rate_interval])", "legendFormat": "tier changes/min" }]
    },
    {
      "id": 10, "type": "timeseries", "title": "Objects forwarded /s per relay",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 12 } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "rate(edgecast_relay_objects_forwarded_total{instance=~\"relay.*\"}[$__rate_interval])", "legendFormat": "{{instance}}" }]
    }
  ]
}
